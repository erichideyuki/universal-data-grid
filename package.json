{
  "name": "@universal-material/data-grid",
  "version": "0.6.0",
  "description": "A high-performance data grid Web Component (<u-grid>) built with Lit: row virtualization, drag-and-drop grouping, column reordering, custom cells, SSR and i18n.",
  "keywords": [
    "web-components",
    "custom-elements",
    "lit",
    "data-grid",
    "datagrid",
    "grid",
    "table",
    "virtualization",
    "universal-material",
    "material-design"
  ],
  "homepage": "https://universal-material.github.io/data-grid/",
  "bugs": {
    "url": "https://github.com/erichideyuki/universal-data-grid/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erichideyuki/universal-data-grid.git"
  },
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/erichideyuki"
  },
  "author": "Eric Kono",
  "type": "module",
  "main": "./dist/grid.js",
  "module": "./dist/grid.js",
  "types": "./dist/grid.d.ts",
  "exports": {
    ".": {
      "types": "./dist/grid.d.ts",
      "default": "./dist/grid.js"
    },
    "./export-xlsx": {
      "types": "./dist/export-xlsx/index.d.ts",
      "default": "./dist/export-xlsx/index.js"
    },
    "./export-pdf": {
      "types": "./dist/export-pdf/index.d.ts",
      "default": "./dist/export-pdf/index.js"
    },
    "./grid.min.js": "./dist/grid.min.js",
    "./export-xlsx.min.js": "./dist/export-xlsx.min.js",
    "./export-pdf.min.js": "./dist/export-pdf.min.js",
    "./custom-elements.json": "./custom-elements.json",
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/grid.min.js",
  "jsdelivr": "./dist/grid.min.js",
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "custom-elements.json",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/grid.js",
    "./dist/grid-column.js",
    "./dist/grid-i18n.js",
    "./dist/grid.min.js",
    "./src/grid.ts",
    "./src/grid-column.ts",
    "./src/grid-i18n.ts"
  ],
  "customElements": "custom-elements.json",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node dev/server",
    "docs:dev": "vite --config docs/vite.config.ts",
    "docs:build": "vite build --config docs/vite.config.ts",
    "docs:preview": "vite preview --config docs/vite.config.ts",
    "docs:publish": "npm run docs:build && node docs/publish.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p src && node scripts/bundle-exports.mjs workers",
    "build:pdf": "cargo build --manifest-path pdf/Cargo.toml --release --lib --target wasm32-unknown-unknown && node -e \"require('fs').copyFileSync('pdf/target/wasm32-unknown-unknown/release/grid_pdf.wasm','src/export-pdf/grid-pdf.wasm')\"",
    "test:pdf-engine": "cargo test --manifest-path pdf/Cargo.toml --release",
    "build:xlsx": "cargo build --manifest-path xlsx/Cargo.toml --release --lib --target wasm32-unknown-unknown && node -e \"require('fs').copyFileSync('xlsx/target/wasm32-unknown-unknown/release/grid_xlsx.wasm','src/export-xlsx/grid-xlsx.wasm')\"",
    "test:xlsx-engine": "cargo test --manifest-path xlsx/Cargo.toml --release",
    "bundle": "rollup -c",
    "bundle:browser": "esbuild src/grid.ts --bundle --format=esm --minify --outfile=dist/grid.min.js && node scripts/bundle-exports.mjs min",
    "typecheck": "tsc --noEmit -p src && tsc --noEmit -p tsconfig.json && tsc --noEmit -p docs",
    "test": "vitest run --project node --project browser",
    "test:perf": "vitest run --project perf --reporter=verbose",
    "test:watch": "vitest",
    "analyze": "cem analyze",
    "lint": "npm run lint:lit-analyzer && npm run lint:eslint ",
    "lint:eslint": "eslint src/**/*.ts",
    "lint:lit-analyzer": "lit-analyzer --strict --rules.no-invalid-css off",
    "prepublishOnly": "npm run typecheck && npm test",
    "prepack": "npm run build && npm run bundle:browser"
  },
  "dependencies": {
    "@lit/context": "^1.1.6",
    "interactjs": "^1.10.27",
    "lit": "^3.3.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/compat": "^2.0.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.1",
    "@interactjs/types": "^1.10.27",
    "@lit-labs/ssr": "^3.3.1",
    "@lit/task": "^1.0.3",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.0",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@universal-material/web": "^3.6.11",
    "@vitest/browser-playwright": "^4.1.12",
    "@webcomponents/template-shadowroot": "^0.2.1",
    "@wwa/rollup-plugin-terser": "^1.1.2",
    "axe-core": "^4.14.1",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-helpers": "^2.0.1",
    "eslint-plugin-jsdoc": "^61.5.0",
    "eslint-plugin-lit": "^2.1.1",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.3.0",
    "express": "^5.3.0",
    "lit-analyzer": "^2.0.3",
    "pdfjs-dist": "^5.7.284",
    "playwright": "^1.65.1",
    "prettier": "^3.7.4",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "rollup": "^4.68.5",
    "rollup-plugin-summary": "^3.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
