{
  "name": "@universal-material/data-grid",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "Paid",
  "scripts": {
    "dev": "node dev/server",
    "bundle": "rollup -c",
    "bundle:browser": "esbuild src/grid.ts --bundle --format=esm --minify --define:process.env.NODE_ENV=\"production\" --outfile=dist/grid.min.js",
    "build": "tsc -p src",
    "typecheck": "tsc --noEmit -p src && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "cem analyze --litelement --globs \"src/**/*.ts\" --exclude \"src/**/*.test.ts\" \"src/test/**\"",
    "lint": "npm run lint:lit-analyzer && npm run lint:eslint ",
    "lint:eslint": "eslint src/**/*.ts",
    "lint:lit-analyzer": "lit-analyzer --strict --rules.no-invalid-css off"
  },
  "dependencies": {
    "@lit/context": "^1.1.6",
    "@tanstack/lit-virtual": "^3.13.13",
    "interactjs": "^1.10.27",
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/compat": "^2.0.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.1",
    "@interactjs/types": "^1.10.27",
    "@lit-labs/ssr": "^3.3.1",
    "@lit/task": "^1.0.3",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.0",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@universal-material/web": "^3.6.11",
    "@vitest/browser-playwright": "^4.1.12",
    "@webcomponents/template-shadowroot": "^0.2.1",
    "@wwa/rollup-plugin-terser": "^1.1.2",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-helpers": "^2.0.1",
    "eslint-plugin-jsdoc": "^61.5.0",
    "eslint-plugin-lit": "^2.1.1",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.3.0",
    "express": "^5.3.0",
    "lit-analyzer": "^2.0.3",
    "playwright": "^1.65.1",
    "prettier": "^3.7.4",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "rollup": "^4.68.5",
    "rollup-plugin-summary": "^3.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "customElements": "custom-elements.json"
}
